name: Import Custom KernelSU
on:
  workflow_dispatch:
    inputs:
      target_branch:
        description: 'Nama branch tujuan (jika belum ada, akan otomatis dibuat)'
        required: true
        default: 'custom-ksu'
      ksu_setup_link:
        description: 'Link URL ke script setup.sh (raw)'
        required: true
        default: 'https://raw.githubusercontent.com/ReSukiSU/ReSukiSU/main/kernel/setup.sh'
      ksu_version:
        description: 'Versi / Tag / Branch KSU yang dituju'
        required: true
        default: 'v.4.1.0'

jobs:
  import-ksu:
    runs-on: ubuntu-latest
    permissions:
      contents: write # Izin agar bot bisa melakukan push dan commit
      
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3
        with:
          fetch-depth: 0 # Diperlukan untuk mengambil semua informasi branch

      - name: Setup Target Branch
        run: |
          # Mencoba pindah ke branch yang diinputkan. 
          # Jika gagal (branch belum ada), maka buat branch baru dari branch utama (main/master).
          git checkout ${{ github.event.inputs.target_branch }} || git checkout -b ${{ github.event.inputs.target_branch }}

      - name: Download & Setup Custom KernelSU
        run: |
          echo "Mengunduh dari: ${{ github.event.inputs.ksu_setup_link }}"
          echo "Menggunakan versi: ${{ github.event.inputs.ksu_version }}"
          
          # 1. Menjalankan script setup sesuai link dan versi dari input
          curl -LSs ${{ github.event.inputs.ksu_setup_link }} | bash -s ${{ github.event.inputs.ksu_version }}

          # 2. Menghapus folder .git bawaan KSU agar menjadi file lokal (bukan submodule)
          find . -type d -path "*/KernelSU/.git" -exec rm -rf {} + 2>/dev/null || true
          find . -type d -path "*/drivers/kernelsu/.git" -exec rm -rf {} + 2>/dev/null || true
          rm -f .gitmodules

      - name: Commit & Push ke Branch [ ${{ github.event.inputs.target_branch }} ]
        run: |
          # 3. Menambahkan semua file yang diunduh sebagai commit baru
          git config --global user.name "GitHub Action Bot"
          git config --global user.email "action@github.com"
          git add .
          
          # Cek apakah ada perubahan, jika ada lakukan commit ke branch yang dituju
          if ! git diff-index --quiet HEAD; then
            git commit -m "Import Custom KernelSU (${{ github.event.inputs.ksu_version }})"
            git push -u origin ${{ github.event.inputs.target_branch }}
          else
            echo "Tidak ada file baru. KernelSU sudah ada dan up-to-date di branch ini."
          fi
